# GitHub Personal Access Token
# Required scope: `repo` (classic) or fine-grained token with "Contents: Read and write"
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# Password required to open the GitPulse dashboard
SITE_PASSWORD=choose_a_long_unique_password

# Admin vault password (defaults to SITE_PASSWORD if unset)
# ADMIN_PASSWORD=choose_a_separate_long_password

# Secret key used to protect your /api/cron endpoint from unauthorized calls
CRON_SECRET=your_super_secret_cron_key_12345

# Retired: TARGET_FILE (.github-pulse.md automation removed, do not use)

# How many repositories to commit to per cron run ("all" or a number like 5 or 10)
COMMIT_BATCH_SIZE=10

# Exclude forks by default (true or false)
EXCLUDE_FORKS=true

# Daily scheduler settings (Asia/Kolkata)
DAILY_SCHEDULE_COUNT=3
SCHEDULE_START_HOUR_IST=9
SCHEDULE_END_HOUR_IST=21

# Optional: Comma-separated list of repository names to specifically include or exclude
# INCLUDE_REPOS=my-repo-1,my-repo-2
# EXCLUDE_REPOS=archive-repo,legacy-project
